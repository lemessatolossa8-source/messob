# ─────────────────────────────────────────────────────────────────────────────
# Burayu MESOB — Frontend (Next.js) Environment Variables (.env.local.example)
# Use this template for local .env.local or enter these in Vercel's Environment Variables.
# NEVER commit .env.local with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend Connection (Set in Vercel Project Settings -> Environment Variables) ──
# 1. NEXT_PUBLIC_API_URL: The public URL of your Express API on Render (with /api suffix, no trailing slash).
# Example: https://burayu-mesob-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# 2. BACKEND_URL: Used by Next.js server rewrites and SSR data fetching (no trailing slash).
# Example: https://burayu-mesob-api.onrender.com
BACKEND_URL=https://your-backend-api.onrender.com

# ── JWT Verification ──────────────────────────────────────────────────────────
# Must match the backend JWT_SECRET exactly (used by Next.js edge/middleware to guard /admin/dashboard routes).
JWT_SECRET=replace_with_the_same_64_character_hex_string_used_in_backend

# ── Public Website Domain ─────────────────────────────────────────────────────
# Your production Vercel domain (used for canonical URLs and SEO metadata).
NEXT_PUBLIC_SITE_URL=https://burayu-mesob.vercel.app

# ── Optional: Cloudinary Storage (if using direct client-side uploads) ────────
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
