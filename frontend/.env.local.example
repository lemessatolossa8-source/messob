# ─────────────────────────────────────────────────────────────────────────────
# Burayu MESOB — Frontend (Next.js) Environment Variables
# Copy this file to .env.local and fill in every value before building.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend Connection ────────────────────────────────────────────────────────
# In production on Vercel/Netlify: set this to your hosted backend URL (no trailing slash).
# Example: https://burayu-mesob-api.onrender.com
BACKEND_URL=https://your-backend-api.onrender.com

# NEXT_PUBLIC_API_URL can match your public backend or be left empty if using BACKEND_URL rewrites:
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# ── JWT verification (Must match the backend JWT_SECRET exactly) ──────────────
# Used by src/proxy.js to guard /admin/dashboard routes.
JWT_SECRET=replace_with_the_same_64_char_random_hex_string_as_the_backend

# ── Public Site URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://burayu-mesob.vercel.app
