# ─────────────────────────────────────────────────────────────────────────────
# Burayu MESOB — Backend Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_strong_db_password
DB_NAME=burayu_mesob

# ── Application ───────────────────────────────────────────────────────────────
PORT=5000

# Must be "production" on the live server so:
#  - stack traces are suppressed in error responses
#  - sequelize.sync({ alter:true }) is disabled
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# The public URL of the Next.js frontend (no trailing slash)
CLIENT_URL=https://your-production-domain.com

# ── Email (for OTP and notifications) ─────────────────────────────────────────
# Email service provider (gmail, outlook, etc.)
EMAIL_SERVICE=gmail
# Email address to send from
EMAIL_USER=your_email@gmail.com
# App password (for Gmail, generate at: https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=your_app_password
# Admin email for password recovery
ADMIN_EMAIL=lemessatolossa8@gmail.com

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
