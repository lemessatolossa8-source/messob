# ─────────────────────────────────────────────────────────────────────────────
# Burayu MESOB — Backend Environment Variables (.env.example)
# Use this template for local .env or copy these keys into Render Environment Settings.
# NEVER commit the real .env file with actual secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Aiven MySQL / Cloud MySQL) ───────────────────────────────────────
# Option A: Single Connection URL (Recommended for Render & Aiven)
# Copy the "Service URI" from your Aiven MySQL Service Overview tab:
# Example: mysql://avnadmin:your_password@mysql-xxxxx.aivencloud.com:28020/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:your_aiven_password@your_aiven_host.aivencloud.com:28020/defaultdb?ssl-mode=REQUIRED

# Option B: Individual Variables (Alternative if not using DATABASE_URL)
# DB_HOST=your_aiven_host.aivencloud.com
# DB_PORT=28020
# DB_USER=avnadmin
# DB_PASS=your_aiven_password
# DB_NAME=defaultdb
# DB_SSL=true

# Database Connection Pool (Optional, tailored for Aiven free/developer connection limits)
DB_POOL_MAX=10
DB_POOL_MIN=0

# Optional: If you downloaded the Aiven CA certificate (ca.pem), you can paste its contents here.
# Otherwise, SSL automatically accepts the TLS handshake securely with rejectUnauthorized: false.
# DB_CA_CERT=

# ── Application Configuration ──────────────────────────────────────────────────
# Render assigns PORT automatically; default is 5000 for local development.
PORT=5000

# Set to "production" on Render / live server. Set to "development" locally.
NODE_ENV=production

# ── Authentication & Security ──────────────────────────────────────────────────
# Generate a secure 64-char hex key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_64_character_random_hex_string
JWT_EXPIRES_IN=7d

# ── CORS Settings ──────────────────────────────────────────────────────────────
# Public URL(s) of your Vercel frontend (comma-separated if multiple, no trailing slashes).
# Example: https://burayu-mesob.vercel.app,http://localhost:3000
CLIENT_URL=https://your-mesob-frontend.vercel.app

# ── Email Service (for OTP Admin Password Recovery & Inquiries) ────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_16_char_app_password
ADMIN_EMAIL=lemessatolossa8@gmail.com
CONTACT_RECIPIENT_EMAIL=lemessatolossa8@gmail.com

# ── Cloudinary Image Storage (Optional) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
