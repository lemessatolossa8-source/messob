# ─────────────────────────────────────────────────────────────────────────────
# Burayu MESOB — Frontend (Next.js) Environment Variables
# Copy this file to .env.local and fill in every value before building.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Direct MySQL access (used by Next.js API routes) ─────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_strong_db_password
DB_NAME=burayu_mesob

# ── JWT verification (must match the backend JWT_SECRET exactly) ──────────────
# Used by src/lib/apiAuth.js and src/middleware.js to verify tokens.
JWT_SECRET=replace_with_the_same_64_char_random_hex_string_as_the_backend

# ── API base URL (optional) ───────────────────────────────────────────────────
# Leave unset to use Next.js built-in API routes (/api/*).
# Set this only if you run the Express backend on a separate domain/port.
# NEXT_PUBLIC_API_URL=https://api.your-production-domain.com/api
